{
    "version": 2,
    "buildCommand": "pnpm install && vite build && esbuild api/index.ts --platform=node --bundle --packages=external --format=esm --outfile=api/index.js",
    "installCommand": "pnpm install",
    "outputDirectory": "dist/public",
    "framework": null,
    "functions": {
        "api/index.js": {
            "memory": 1024,
            "maxDuration": 30
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}